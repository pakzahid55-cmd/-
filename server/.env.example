# KAJOK server environment — copy to server/.env for local runs
NODE_ENV=development
PORT=4000

# PostgreSQL connection string. When set, PgStore is used automatically.
# Leave empty to use the embedded MemoryStore (local testing only).
DATABASE_URL=

# Auth token signing — change in production!
JWT_SECRET=kajok-dev-secret-change-in-production
JWT_EXPIRES_IN=7d

# Comma separated allowed CORS origins (optional)
CORS_ORIGINS=

# Checkout settings
SHIPPING_FEE=5.99
FREE_SHIPPING_OVER=150

# Online payments require a real provider — never simulate success.
ONLINE_PAYMENTS_ENABLED=false
