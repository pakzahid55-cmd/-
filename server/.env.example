# KAJOK API server — environment configuration
# Copy to server/.env and adjust values.

PORT=4000
NODE_ENV=development

# PostgreSQL connection string.
# When set, the PostgreSQL adapter (src/db/pg-store.ts) is used with schema.sql.
# When empty, the embedded development store (server/data/db.json) is used.
# DO NOT commit real credentials.
# DATABASE_URL=postgres://user:password@localhost:5432/kajok

# JWT signing secret — REQUIRED in production (use a long random string).
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Optional comma-separated CORS origin allowlist (empty = allow same-origin/proxy usage).
# CORS_ORIGINS=https://your-domain.com

# Shipping rules (USD)
SHIPPING_FEE=5.99
FREE_SHIPPING_OVER=150

# Online payments stay disabled until a real payment provider is integrated.
# Never simulate successful payments.
ONLINE_PAYMENTS_ENABLED=false
