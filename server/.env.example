# Copy to .env and adjust. Never commit real secrets.

# --- Server ---
PORT=8080
HOST=0.0.0.0
# Secret used to sign JWT session tokens. REQUIRED in production.
JWT_SECRET=change-me-to-a-long-random-string
# Point to a real PostgreSQL server in production.
# When unset, the embedded PostgreSQL-compatible engine (pg-mem) is used
# with automatic JSON snapshot persistence in KAJOK_DATA_DIR.
# DATABASE_URL=postgresql://kajok:secret@localhost:5432/kajok
KAJOK_DATA_DIR=../data
