# Preview defaults. With no Firebase config the development store is seeded.
NODE_ENV=development
PORT=4000

# Production: set all three and use Application Default Credentials (ADC).
# KUJUK_STORE=firestore
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
KUJUK_SUPER_ADMIN_UID=

# Optional existing PostgreSQL development/migration adapter.
DATABASE_URL=

# Specify only if the API is behind a known number of trusted proxy hops.
KUJUK_TRUST_PROXY_HOPS=0
CORS_ORIGINS=

# Per-shipment fees and free-shipping threshold, in base EGP.
# These values are examples, not a carrier tariff.
SHIPPING_FEE=5.99
SHIPPING_FEE_SUDAN=15
FREE_SHIPPING_OVER=150
COMMISSION_BPS=1000
