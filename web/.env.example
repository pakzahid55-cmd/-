# KAJOK web app — environment configuration
# Copy to web/.env.local and adjust values.
#
# Firebase web configuration. These are PUBLIC identifiers restricted by
# Firebase Security Rules — never put service-account / Admin SDK keys here.
# The app falls back to the kajok-65089 project defaults in src/lib/firebase.ts.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=kajok-65089.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=kajok-65089
VITE_FIREBASE_STORAGE_BUCKET=kajok-65089.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=902554080627
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=G-EKDXMLJ357
